NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (NOT NEXT_PUBLIC) — used by /api/cv-parse to read CVs with Claude.
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot that DMs job alerts to seafarers and posts every new vacancy to the
# public channel. Create the bot with @BotFather, then open
# /api/telegram/setup?secret=<CRON_SECRET> once to register the webhook.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Any long random string. REQUIRED — the webhook rejects every update without
# it, since the URL is otherwise guessable.
TELEGRAM_WEBHOOK_SECRET=some-long-random-string
# The channel vacancies are mirrored to. Either @handle or the numeric id; the
# bot must be an administrator of it with "post messages" allowed.
TELEGRAM_CHANNEL_ID=@seajobs_pro
# The one language the bot writes in — channel posts, job-alert DMs and the
# replies to /start and /stop (en | ru | ua | pl | ro). Default: en.
TELEGRAM_LANG=en
# Public channel handle used for the "open the channel" link in the UI.
NEXT_PUBLIC_TELEGRAM_CHANNEL=seajobs_pro
# Optional: skips a getMe call when building deep links.
TELEGRAM_BOT_USERNAME=seajobspro_bot
# Optional: the private chat that gets a message on every CV-distribution
# request. Your own numeric chat id — send /id to the bot and it replies with it.
# Unset means no notification; the request is still saved.
TELEGRAM_ADMIN_CHAT_ID=123456789
