# Supabase — optional. Without these the site renders from built-in seed data
# (lib/data.ts), so `npm run dev` works out of the box. Set them to switch the
# content layer to the live Postgres backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by Server Components / route handlers for trusted reads.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel password (server-only). The /admin UI sends it as a Bearer token;
# every /api/admin/* route checks it. If unset, the admin API is fully denied.
ADMIN_PASSWORD=

# Anthropic API — powers the "recipe from a photo" import in the admin panel
# (reads a food photo, writes a unique RU+EN recipe). Without it, that one
# feature is disabled; everything else still works.
ANTHROPIC_API_KEY=
# Optional — override the model used for photo→recipe parsing.
# Defaults to claude-haiku-4-5-20251001; set a stronger model for richer copy.
RECIPE_AI_MODEL=
